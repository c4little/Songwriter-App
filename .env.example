# Copy to .env.local (web) and set the same values as Modal secrets (worker).
# Never commit real values. Every variable from PRD section 14 is listed here.

# --- Supabase (web) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (web server code: listen page, delete; worker) ---
# Bypasses row-level security. Server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modal worker (web route handlers, worker) ---
# Base URL of the Modal web endpoints, e.g. https://<workspace>--songwriter-worker
MODAL_ENDPOINT_URL=
# Shared secret sent as the X-Worker-Secret header. Generate with: openssl rand -base64 32
WORKER_SECRET=

# --- Print route (web, worker) ---
# Signs short-lived tokens for /songs/:id/print. Generate with: openssl rand -base64 32
RENDER_TOKEN_SECRET=

# --- Email (worker) ---
RESEND_API_KEY=
EMAIL_FROM="Songwriter <sheets@example.com>"

# --- App (QR links, email links, print route) ---
APP_BASE_URL=http://localhost:3000
